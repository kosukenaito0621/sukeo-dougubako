---
/** ページの下のフッター（詳細ページ・404） */
import { SITE } from '../site.config';
---

<footer class="site-footer">
  <a href="/" class="footer-logo"><img src="/favicon.svg" alt="" width="40" height="40" class="footer-face" />{SITE.name}</a>
  <p class="footer-tag">{SITE.tagline}</p>
</footer>

<style>
  .site-footer {
    display: grid;
    justify-items: center;
    gap: 2px;
    padding: 32px 16px 40px;
    color: var(--ink-soft);
    text-align: center;
  }
  .footer-logo {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    color: var(--ink);
    font-weight: 700;
    text-decoration: none;
  }
  .footer-face {
    width: 40px;
    height: 40px;
  }
</style>
