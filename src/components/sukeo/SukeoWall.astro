---
/**
 * すけお（壁にはりつく・背中側から見た姿）。オープニング用。
 * asleep のときは目を閉じた状態で描き、wake() で目を開ける。
 * wakeable のときは目を開けた状態で描く（JS が動くときだけ sleep() で閉じてから wake() する）。
 */
import Eye from './Eye.astro';
import Layer from './Layer.astro';
import Shapes from './Shapes.astro';
import SoftDefs from './SoftDefs.astro';
import { C, along, arc, blob, ellipse, scatter, spines, taper, taperW, toes, uid, type Pt, type Shape } from './parts';

interface Props {
  asleep?: boolean;
  wakeable?: boolean;
  label?: string;
  class?: string;
}
const { asleep = false, wakeable = false, label, class: className } = Astro.props;
const eyeState = asleep ? 'asleep' : wakeable ? 'wakeable' : 'open';
const fx = uid();

const tailLine: Pt[] = [[110, 190], [110, 214], [120, 230], [122, 244], [112, 253], [100, 249], [97, 239]];
const core: Shape[] = [
  ellipse(110, 64, 30, 33), // 頭
  ellipse(110, 40, 20, 16), // 鼻先
  ellipse(110, 76, 36, 20), // あごのうしろ（幅が広い）
  ellipse(82, 62, 10, 12), // 目のふくらみ
  ellipse(138, 62, 10, 12),
  ellipse(110, 98, 22, 16), // 首
  ellipse(110, 118, 30, 16), // 肩
  ellipse(110, 148, 32, 48), // 胴
  ellipse(110, 184, 26, 16), // 腰
  taper(tailLine, 22, 5),
];
const crest: Shape[] = [
  ...spines(arc(84, 60, 11, -200, -110, 5), 4, 4.2, 3.8, -1, 0.3),
  ...spines(arc(136, 60, 11, -70, 20, 5), 4, 4.2, 3.8, -1, -0.3),
  ...spines([[86, 76], [86, 96], [82, 120], [80, 148], [84, 176], [92, 192]], 11, 4.6, 4.4, 1, -0.45),
  ...spines([[134, 76], [134, 96], [138, 120], [140, 148], [136, 176], [128, 192]], 11, 4.6, 4.4, -1, -0.45),
];
const blotches = [
  blob(110, 54, 6, 4, 0, 81), blob(96, 128, 7, 4.4, 70, 82), blob(124, 142, 7, 4.4, -70, 83),
  blob(98, 164, 6, 4, 60, 84), blob(122, 178, 5, 3.4, -60, 85),
];
const tailBands = [0.15, 0.32, 0.5, 0.68].map((t, i) => {
  const p = along(tailLine, t);
  return blob(p.x, p.y, 7.5 - i * 0.8, 3.2 - i * 0.3, p.deg + 90, 90 + i);
});
const speckles = scatter(84, 40, 136, 190, 26, 11);

function limb(line: Pt[], widths: number[], hx: number, hy: number, dirs: number[]) {
  const t = toes(hx, hy, dirs, 11, 5);
  return { shapes: [taperW(line, widths), ...t.shapes], pads: t.pads };
}
// 指を大きく広げて壁をつかむ
const legs = [
  { part: 'leg-fl', ...limb([[90, 118], [64, 112], [54, 96], [52, 86]], [16, 11, 10, 9], 51, 82, [-172, -141, -110, -79, -48]) },
  { part: 'leg-fr', ...limb([[130, 118], [156, 112], [166, 96], [168, 86]], [16, 11, 10, 9], 169, 82, [-8, -39, -70, -101, -132]) },
  { part: 'leg-bl', ...limb([[92, 180], [64, 182], [52, 198], [50, 210]], [18, 12, 10, 9], 49, 214, [70, 101, 132, 163, 194]) },
  { part: 'leg-br', ...limb([[128, 180], [156, 182], [168, 198], [170, 210]], [18, 12, 10, 9], 171, 214, [110, 79, 48, 17, -14]) },
];
---

<svg
  viewBox="0 0 220 262"
  xmlns="http://www.w3.org/2000/svg"
  class:list={['sukeo', 'sukeo--wall', className]}
  data-sukeo="wall"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
>
  <SoftDefs id={fx} />

  {
    legs.map((l) => (
      <Layer fx={fx} shapes={l.shapes} fill={C.body} part={l.part}>
        <Shapes shapes={l.pads} fill={C.pad} />
      </Layer>
    ))
  }

  <Layer fx={fx} shapes={core} fill={C.body} part="body">
    <!-- 背中の中心は少し明るい -->
    <ellipse cx="110" cy="140" rx="12" ry="56" fill="#F4BE74" opacity="0.7" filter={`url(#${fx}-haze)`} />
    <g filter={`url(#${fx}-blur)`} opacity="0.6">
      {[...blotches, ...tailBands].map((d, i) => <path d={d} fill={i % 3 === 2 ? C.olive : C.blotch} />)}
    </g>
    {speckles.map((s) => <circle cx={s.x} cy={s.y} r={0.7 + s.k * 0.9} fill={C.speckle} opacity="0.75" />)}
  </Layer>

  <Layer fx={fx} shapes={crest} fill={C.crest} filter="thin" />

  <g data-part="head">
    <Eye fx={fx} x={84} y={60} r={8} state={eyeState} />
    <Eye fx={fx} x={136} y={60} r={8} state={eyeState} />
    <ellipse cx="104.5" cy="32" rx="1.5" ry="1.1" fill={C.mouth} />
    <ellipse cx="115.5" cy="32" rx="1.5" ry="1.1" fill={C.mouth} />
  </g>
</svg>
