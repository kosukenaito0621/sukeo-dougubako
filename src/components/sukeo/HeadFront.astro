---
/**
 * すけおの頭（正面）。SoftDefs の id（fx）と、置く位置 (ox, oy) を渡す。
 * - eyes ：open／look（上を見て困る）／wink（右目にっこり）／asleep（閉じた目。wake() で開く）
 * - mouth：smile／open（しゃべる）／wobble（困った口）
 */
import Eye from './Eye.astro';
import Layer from './Layer.astro';
import { C } from './parts';
import { frontHead, type FrontMouth } from './front';

interface Props {
  fx: string;
  ox: number;
  oy: number;
  eyes?: 'open' | 'look' | 'wink' | 'asleep';
  mouth?: FrontMouth;
}
const { fx, ox, oy, eyes = 'open', mouth = 'smile' } = Astro.props;
const h = frontHead(ox, oy, mouth);
---

<Layer fx={fx} shapes={h.shapes} fill={C.body}>
  <rect x={ox - 70} y={oy - 50} width="140" height="90" fill={`url(#${fx}-headback)`} />
  <g filter={`url(#${fx}-blur)`} opacity="0.6">
    {h.blotches.map((d, i) => <path d={d} fill={i % 3 === 2 ? C.olive : C.blotch} />)}
  </g>
  <ellipse cx={ox} cy={oy + 30} rx="30" ry="8" fill={C.belly} opacity="0.85" filter={`url(#${fx}-haze)`} />
  {h.speckles.map((s) => <circle cx={s.x} cy={s.y} r={0.7 + s.k * 0.9} fill={C.speckle} opacity="0.75" />)}
</Layer>
<defs>
  <linearGradient id={`${fx}-headback`} x1="0" y1={oy - 40} x2="0" y2={oy + 30} gradientUnits="userSpaceOnUse">
    <stop offset="0" stop-color={C.dorsal} stop-opacity="0.55" />
    <stop offset="0.5" stop-color={C.dorsal} stop-opacity="0" />
  </linearGradient>
</defs>
<Layer fx={fx} shapes={h.crest} fill={C.crest} filter="thin" />

{
  h.eyes.map((e, i) => (
    <Eye
      fx={fx}
      x={e.x}
      y={e.y}
      r={e.r}
      state={eyes === 'asleep' ? 'asleep' : eyes === 'wink' && i === 1 ? 'happy' : 'open'}
      lookX={eyes === 'look' ? -0.7 : 0}
      lookY={eyes === 'look' ? -0.7 : 0}
    />
  ))
}
{h.nostrils.map((n) => <ellipse cx={n.cx} cy={n.cy} rx="1.8" ry="1.3" fill={C.mouth} />)}
<path d={h.mouth} fill="none" stroke={C.mouth} stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
{
  mouth === 'open' && (
    <g data-part="mouth">
      <path d={h.open.inner} fill={C.mouthIn} stroke={C.mouth} stroke-width="1.4" stroke-linejoin="round" />
      <path d={h.open.tongue} fill={C.tongue} />
    </g>
  )
}
