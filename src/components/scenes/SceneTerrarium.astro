---
/**
 * シーン3：テラリウム（すけおの家・構想中のアプリ）。ガラスの中の深い緑、コルクの枝、苔と土。
 */
import { heartLeaf, leaf, rng, sid } from './shapes';

const id = sid();
const r = rng(11);
const backLeaves = [
  leaf(20, 520, 230, 46, -60), leaf(380, 470, 220, 44, -120), leaf(60, 760, 260, 50, -75),
  leaf(360, 760, 240, 48, -105), leaf(200, 640, 200, 40, -95),
];
const midLeaves = [
  heartLeaf(40, 330, 64, -20), heartLeaf(62, 380, 56, 10), heartLeaf(34, 430, 60, -40),
  heartLeaf(350, 250, 58, 200), heartLeaf(330, 300, 52, 170), heartLeaf(356, 352, 60, 220),
];
const drops = Array.from({ length: 16 }, () => ({ x: r() * 390, y: 40 + r() * 600, s: 1.2 + r() * 2.6 }));
const moss = Array.from({ length: 26 }, (_, i) => ({ x: i * 16 - 6 + r() * 8, y: 742 + r() * 12, rx: 14 + r() * 10, ry: 9 + r() * 6 }));
---

<svg viewBox="0 0 390 844" preserveAspectRatio="xMidYMax slice" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class="scene-bg">
  <defs>
    <linearGradient id={`${id}-bg`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#2b5446" />
      <stop offset="1" stop-color="#1a382e" />
    </linearGradient>
    <linearGradient id={`${id}-cork`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#9b7450" />
      <stop offset="1" stop-color="#6e4f33" />
    </linearGradient>
    <filter id={`${id}-far`} x="-20%" y="-20%" width="140%" height="140%"><feGaussianBlur stdDeviation="4" /></filter>
    <filter id={`${id}-glow`} x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="20" /></filter>
  </defs>

  <rect width="390" height="844" fill={`url(#${id}-bg)`} />
  <ellipse cx="195" cy="40" rx="220" ry="90" fill="#cfe6c3" opacity="0.18" filter={`url(#${id}-glow)`} />

  <!-- 奥の大きな葉（ぼかして遠くに） -->
  <g filter={`url(#${id}-far)`}>
    {backLeaves.map((d, i) => <path d={d} fill={i % 2 ? '#2f5e4b' : '#356a52'} />)}
  </g>

  <!-- コルクの枝 -->
  <path d="M-10 690 C 90 610, 180 560, 260 440 C 300 380, 340 340, 410 300 L 410 336 C 350 372, 316 410, 280 466 C 210 580, 110 640, -10 724 Z" fill={`url(#${id}-cork)`} />
  <path d="M30 670 C 110 612, 190 560, 250 470" fill="none" stroke="#b08a63" stroke-width="2" opacity="0.6" />
  <path d="M60 680 C 130 630, 200 590, 270 480" fill="none" stroke="#5c412a" stroke-width="2" opacity="0.4" />

  <!-- 手前の葉 -->
  {midLeaves.map((d, i) => <path d={d} fill={i % 2 ? '#4a8a5c' : '#3f7a52'} />)}

  <!-- 土と苔 -->
  <rect x="0" y="752" width="390" height="92" fill="#4a3324" />
  {moss.map((m, i) => <ellipse cx={m.x} cy={m.y} rx={m.rx} ry={m.ry} fill={i % 3 ? '#5e8f4e' : '#6fa05a'} />)}
  <ellipse cx="300" cy="790" rx="26" ry="10" fill="#8a9a8c" />
  <ellipse cx="300" cy="786" rx="20" ry="6" fill="#a9bdb7" />

  <!-- ガラスの映りこみと水滴 -->
  <path d="M40 0 L 90 0 L 10 844 L -40 844 Z" fill="#ffffff" opacity="0.05" />
  <path d="M330 0 L 350 0 L 300 844 L 280 844 Z" fill="#ffffff" opacity="0.05" />
  {drops.map((d) => <circle cx={d.x} cy={d.y} r={d.s} fill="#ffffff" opacity="0.22" />)}
  <rect x="2" y="0" width="6" height="844" fill="#ffffff" opacity="0.08" />
  <rect x="382" y="0" width="6" height="844" fill="#ffffff" opacity="0.08" />
</svg>
