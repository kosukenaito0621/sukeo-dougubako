---
/**
 * シーン2：ベランダ・窓辺（植物アプリ）。大きな掃き出し窓、鉢植え、ポトス、じょうろ、木のデッキ。
 */
import { heartLeaf, leaf, sid } from './shapes';

const id = sid();
// 右の大きな鉢の葉（モンステラ風）
const bigLeaves = [
  heartLeaf(300, 560, 70, -120), heartLeaf(306, 560, 64, -75), heartLeaf(296, 566, 58, -160),
  heartLeaf(312, 566, 56, -30), heartLeaf(304, 560, 52, -95),
];
// 左上から垂れるポトス
const pothos = Array.from({ length: 9 }, (_, i) => ({
  d: heartLeaf(40 + (i % 2 ? 14 : -4), 70 + i * 34, 22 - i * 0.6, i % 2 ? 40 : 140),
  c: i % 3 ? '#79ad5a' : '#8dbf66',
}));
// 左の小さな鉢（アガベのロゼット）
const agave = [-150, -125, -100, -80, -55, -30].map((a, i) => leaf(92, 610, 34 - Math.abs(a + 90) * 0.12, 7, a + (i % 2 ? 4 : -4)));
---

<svg viewBox="0 0 390 844" preserveAspectRatio="xMidYMax slice" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class="scene-bg">
  <defs>
    <linearGradient id={`${id}-sky`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#d6ebf0" />
      <stop offset="0.75" stop-color="#eef6ea" />
      <stop offset="1" stop-color="#e3efd3" />
    </linearGradient>
    <linearGradient id={`${id}-deck`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#e2c9a0" />
      <stop offset="1" stop-color="#d3b386" />
    </linearGradient>
    <filter id={`${id}-far`} x="-20%" y="-20%" width="140%" height="140%"><feGaussianBlur stdDeviation="5" /></filter>
    <filter id={`${id}-glow`} x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="18" /></filter>
  </defs>

  <rect width="390" height="844" fill="#f3f0e4" />

  <!-- 窓の外：空と遠くの緑 -->
  <rect x="24" y="56" width="342" height="520" rx="6" fill={`url(#${id}-sky)`} />
  <g filter={`url(#${id}-far)`}>
    <ellipse cx="90" cy="560" rx="120" ry="60" fill="#bcd8a4" />
    <ellipse cx="300" cy="570" rx="140" ry="64" fill="#a9cd90" />
  </g>
  <circle cx="320" cy="110" r="60" fill="#fffbe6" opacity="0.9" filter={`url(#${id}-glow)`} />

  <!-- 窓わく -->
  <g fill="#fbf7ee">
    <rect x="16" y="48" width="358" height="12" rx="4" />
    <rect x="16" y="48" width="12" height="540" rx="4" />
    <rect x="362" y="48" width="12" height="540" rx="4" />
    <rect x="190" y="48" width="10" height="540" />
  </g>
  <!-- カーテン -->
  <path d="M28 60 C 50 200, 30 360, 54 576 L 28 576 Z" fill="#ffffff" opacity="0.75" />
  <path d="M40 60 C 58 200, 46 360, 64 576 L 54 576 C 32 360, 52 200, 34 60 Z" fill="#f0ece0" opacity="0.6" />

  <!-- 窓の下のふちとデッキ -->
  <rect x="0" y="576" width="390" height="22" fill="#e9dcc4" />
  <rect x="0" y="598" width="390" height="246" fill={`url(#${id}-deck)`} />
  {[0, 1, 2, 3, 4, 5, 6].map((i) => <rect x="0" y={626 + i * 32} width="390" height="2" fill="#c4a274" opacity="0.6" />)}
  <path d="M130 598 L 250 598 L 300 844 L 60 844 Z" fill="#fff6dc" opacity="0.28" />

  <!-- ポトス -->
  <path d="M30 60 C 40 140, 26 220, 40 300" fill="none" stroke="#6a9a4c" stroke-width="2.5" />
  {pothos.map((p) => <path d={p.d} fill={p.c} />)}

  <!-- 右の大きな鉢 -->
  {bigLeaves.map((d, i) => <path d={d} fill={i % 2 ? '#5f9550' : '#6fa65c'} />)}
  <path d="M276 640 L 336 640 L 328 704 Q 306 714, 284 704 Z" fill="#d38a5c" />
  <rect x="270" y="630" width="72" height="16" rx="6" fill="#e09a6b" />

  <!-- 左の小さな鉢（アガベ） -->
  {agave.map((d, i) => <path d={d} fill={i % 2 ? '#8db37a' : '#9fc08a'} />)}
  <rect x="70" y="608" width="44" height="34" rx="8" fill="#e8e0d0" />

  <!-- じょうろ -->
  <g transform="translate(150 690)">
    <path d="M0 0 L 58 0 L 54 52 Q 29 60, 4 52 Z" fill="#9cc4c6" />
    <path d="M56 12 L 94 -14 L 98 -8 L 60 22 Z" fill="#8ab5b8" />
    <ellipse cx="97" cy="-12" rx="7" ry="5" fill="#8ab5b8" />
    <path d="M6 0 C 6 -26, 52 -26, 52 0" fill="none" stroke="#8ab5b8" stroke-width="6" />
  </g>
</svg>
