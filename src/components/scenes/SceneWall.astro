---
/**
 * シーン0：壁（オープニング）。朝の光が窓の形にさしこむ、あたたかい漆喰の壁。
 * 縦長の画面（390×844）を基準に描き、横長の画面では左右・上を切り取って表示する。
 */
import { leaf, rng, sid } from './shapes';

const id = sid();
const r = rng(3);
const plaster = Array.from({ length: 90 }, () => ({ x: r() * 390, y: r() * 760, s: 0.5 + r() * 1.3, o: 0.18 + r() * 0.25 }));
const leaves = [
  leaf(300, 120, 70, 16, 150), leaf(310, 150, 64, 14, 175), leaf(296, 180, 58, 13, 200),
  leaf(320, 96, 54, 12, 130), leaf(330, 200, 50, 11, 215),
];
---

<svg viewBox="0 0 390 844" preserveAspectRatio="xMidYMax slice" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class="scene-bg">
  <defs>
    <linearGradient id={`${id}-wall`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#f8f0e3" />
      <stop offset="1" stop-color="#eddcc3" />
    </linearGradient>
    <filter id={`${id}-soft`} x="-20%" y="-20%" width="140%" height="140%"><feGaussianBlur stdDeviation="7" /></filter>
    <filter id={`${id}-leafy`} x="-20%" y="-20%" width="140%" height="140%"><feGaussianBlur stdDeviation="2.5" /></filter>
  </defs>

  <rect width="390" height="844" fill={`url(#${id}-wall)`} />
  {plaster.map((p) => <circle cx={p.x} cy={p.y} r={p.s} fill="#dcc6a4" opacity={p.o} />)}

  <!-- 窓からさしこむ朝の光（格子の影つき） -->
  <g filter={`url(#${id}-soft)`} opacity="0.85">
    <path d="M70 150 L 300 96 L 318 420 L 92 470 Z" fill="#fff7e4" />
  </g>
  <g filter={`url(#${id}-soft)`} opacity="0.5">
    <path d="M182 124 L 194 121 L 212 441 L 200 444 Z" fill="#efdfc6" />
    <path d="M80 306 L 308 256 L 309 268 L 81 318 Z" fill="#efdfc6" />
  </g>
  <!-- 窓の外の植物の影 -->
  <g filter={`url(#${id}-leafy)`} fill="#8a6a44" opacity="0.12">
    {leaves.map((d) => <path d={d} />)}
    <path d="M318 80 C 300 130, 296 190, 300 240" fill="none" stroke="#8a6a44" stroke-width="3" />
  </g>

  <!-- 幅木と床 -->
  <rect x="0" y="752" width="390" height="34" fill="#e6d0ac" />
  <rect x="0" y="752" width="390" height="4" fill="#f2e2c6" />
  <rect x="0" y="786" width="390" height="58" fill="#d9bc90" />
  {[0, 1, 2, 3].map((i) => <rect x="0" y={798 + i * 13} width="390" height="1.2" fill="#c7a576" opacity="0.6" />)}
</svg>
