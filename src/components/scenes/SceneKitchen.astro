---
/**
 * シーン1：キッチン（献立アプリ）。タイルの壁、棚の保存びん、湯気の立つ鍋、木のカウンター。
 */
import { leaf, sid } from './shapes';

const id = sid();
const jars = [
  { x: 30, w: 34, h: 46, fill: '#f3dfb4', lid: '#c98a52' },
  { x: 74, w: 30, h: 38, fill: '#c9573a', lid: '#8f6a45' },
  { x: 112, w: 36, h: 50, fill: '#fbf3e2', lid: '#c98a52' },
];
const herbs = [leaf(178, 266, 26, 6, -110), leaf(178, 266, 24, 6, -70), leaf(178, 268, 22, 5, -140), leaf(178, 268, 22, 5, -40)];
---

<svg viewBox="0 0 390 844" preserveAspectRatio="xMidYMax slice" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class="scene-bg">
  <defs>
    <linearGradient id={`${id}-wall`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#fcf1e4" />
      <stop offset="1" stop-color="#f5dfc6" />
    </linearGradient>
    <linearGradient id={`${id}-sky`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#fdf4e0" />
      <stop offset="1" stop-color="#f8dfba" />
    </linearGradient>
    <pattern id={`${id}-tile`} width="40" height="22" patternUnits="userSpaceOnUse">
      <rect width="40" height="22" fill="#ebdcc4" />
      <rect x="1" y="1" width="38" height="9.5" rx="2" fill="#fff8ec" />
      <rect x="-19" y="12" width="38" height="9.5" rx="2" fill="#fff8ec" />
      <rect x="21" y="12" width="38" height="9.5" rx="2" fill="#fff8ec" />
    </pattern>
    <filter id={`${id}-steam`} x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="3" /></filter>
    <filter id={`${id}-soft`} x="-20%" y="-20%" width="140%" height="140%"><feGaussianBlur stdDeviation="8" /></filter>
  </defs>

  <rect width="390" height="844" fill={`url(#${id}-wall)`} />

  <!-- 窓 -->
  <rect x="236" y="84" width="128" height="168" rx="14" fill="#fffaf2" />
  <rect x="246" y="94" width="108" height="148" rx="8" fill={`url(#${id}-sky)`} />
  <rect x="298" y="94" width="5" height="148" fill="#fffaf2" />
  <rect x="246" y="166" width="108" height="5" fill="#fffaf2" />
  <ellipse cx="300" cy="300" rx="90" ry="40" fill="#fff6e2" opacity="0.6" filter={`url(#${id}-soft)`} />

  <!-- 棚と保存びん・ハーブ -->
  {
    jars.map((j) => (
      <g>
        <rect x={j.x} y={286 - j.h} width={j.w} height={j.h} rx="9" fill="#fffaf3" opacity="0.75" />
        <rect x={j.x + 3} y={286 - j.h * 0.72} width={j.w - 6} height={j.h * 0.72 - 3} rx="6" fill={j.fill} />
        <rect x={j.x + 2} y={286 - j.h - 7} width={j.w - 4} height="9" rx="3" fill={j.lid} />
        <rect x={j.x + 6} y={286 - j.h + 6} width="4" height={j.h * 0.5} rx="2" fill="#fff" opacity="0.5" />
      </g>
    ))
  }
  <path d="M164 286 L 192 286 L 188 266 L 168 266 Z" fill="#d07a52" />
  <g fill="#7fae5c">{herbs.map((d) => <path d={d} />)}</g>
  <rect x="16" y="286" width="196" height="9" rx="3" fill="#c99a66" />
  <rect x="16" y="295" width="196" height="5" rx="2" fill="#b5844f" />

  <!-- 調理道具のレール -->
  <rect x="40" y="378" width="170" height="4" rx="2" fill="#c9a27a" />
  <g fill="#c9a27a">
    <rect x="70" y="380" width="4" height="56" rx="2" />
    <ellipse cx="72" cy="444" rx="11" ry="9" />
    <rect x="118" y="380" width="4" height="50" rx="2" />
    <rect x="110" y="428" width="20" height="18" rx="5" />
    <rect x="166" y="380" width="4" height="40" rx="2" />
    <ellipse cx="168" cy="436" rx="9" ry="16" fill="none" stroke="#c9a27a" stroke-width="3" />
  </g>

  <!-- タイルの壁 -->
  <rect x="0" y="470" width="390" height="180" fill={`url(#${id}-tile)`} />

  <!-- 鍋と湯気（右側。左はすけおが立つ場所としてあけておく） -->
  <g transform="translate(196 0)">
  <g filter={`url(#${id}-steam)`} fill="none" stroke="#fffaf2" stroke-width="7" stroke-linecap="round" opacity="0.8">
    <path d="M86 560 C 74 540, 98 526, 86 506 C 76 490, 94 478, 88 462" />
    <path d="M116 556 C 128 538, 106 522, 118 504" />
  </g>
  <rect x="44" y="578" width="112" height="70" rx="20" fill="#e07a55" />
  <rect x="44" y="578" width="112" height="16" rx="8" fill="#c9623f" />
  <rect x="36" y="566" width="128" height="16" rx="8" fill="#e9906c" />
  <rect x="88" y="556" width="24" height="12" rx="6" fill="#c9623f" />
  <rect x="26" y="598" width="22" height="9" rx="4.5" fill="#c9623f" />
  <rect x="152" y="598" width="22" height="9" rx="4.5" fill="#c9623f" />
  </g>

  <!-- まな板と野菜（左のすみ） -->
  <g transform="translate(-200 0)">
  <rect x="226" y="626" width="130" height="22" rx="10" fill="#e3bf8e" />
  <circle cx="262" cy="618" r="16" fill="#e2593e" />
  <path d="M256 603 Q 262 596, 268 603" fill="none" stroke="#6f9e4a" stroke-width="4" stroke-linecap="round" />
  <ellipse cx="318" cy="620" rx="26" ry="11" fill="#8fbf6a" />
  <ellipse cx="312" cy="616" rx="16" ry="7" fill="#a6cf7f" />
  </g>

  <!-- カウンター -->
  <rect x="0" y="648" width="390" height="18" fill="#ead3b1" />
  <rect x="0" y="666" width="390" height="178" fill="#d9a877" />
  <rect x="18" y="690" width="166" height="140" rx="12" fill="#d09c69" />
  <rect x="206" y="690" width="166" height="140" rx="12" fill="#d09c69" />
  <rect x="160" y="740" width="14" height="5" rx="2.5" fill="#a57447" />
  <rect x="216" y="740" width="14" height="5" rx="2.5" fill="#a57447" />
</svg>
